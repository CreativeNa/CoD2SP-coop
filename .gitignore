# build outputs
*.dll
*.exe
*.obj
*.pdb
*.ilk

# working data derived from the game - never committed
scripts/
saves/
backup/

# large test artefacts
logs/*.png
logs/*.dmp

# keep the curated text evidence
!logs/*.log

# built package for the second machine
dist/

# generated by tools/build_release.ps1 (embedded bridge + mod, ~1 MB of text)
launcher/blobs.h

# linker byproducts of the DLL builds
*.exp
*.lib

# Python bytecode
__pycache__/
*.pyc
