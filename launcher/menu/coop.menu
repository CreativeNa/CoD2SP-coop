#include "ui/menudef.h"

{
// ------------------------------------------------------------------------------------------------------------
// CO-OP popup: opened from the CO-OP button that tools\patch_menu.py adds to the main menu.
// It only sets two dvars; the bridge (cod2net5.dll, loaded by the d3d9 proxy) reads them:
//   coop_cmd = "host" | "join" | "off"        coop_ip = the host's IPv4 address (for Join)
// Built only from syntax found in the game's own menus (ui/quit.menu popup, ui/save_load.menu edit field).
// ------------------------------------------------------------------------------------------------------------

	menuDef
	{
		name "coop_menu"
		visible 0
		fullscreen 0
		rect 140 40 360 440
		focusColor GLOBAL_FOCUSED_COLOR
		style 1
		border 1
		popup
		onOpen
		{
			// the edit field only works on a dvar that exists: create coop_ip. "auto" = find the host by its beacon;
			// a typed address (a.b.c.d) is used as it is.
			setdvar coop_ip "auto";
			// the bridge paints the status text into this dvar (40 blanks = the room it writes into)
			// creating coop_cmd now lets the bridge find it before the first click; "idle" changes nothing
			setdvar coop_cmd "idle";
			setdvar coop_status "                                        ";
			// the remembered settings (window, mouse, mission follow, address): the bridge keeps main\coop_prefs.cfg up to date
			exec "exec coop_prefs.cfg";
		}
		onESC { close coop_menu; }

		itemDef
		{
			name backimage2fade
			style WINDOW_STYLE_SHADER
			rect -140 -90 640 480
			background "white"
			forecolor 0 0 0 0.3
			backcolor 0 0 0 0.3
			visible 1
			decoration
		}
		itemDef
		{
			name backimage2
			style WINDOW_STYLE_SHADER
			rect -60 0 480 440
			background "popmenu_bg"
			visible 1
			decoration
		}
		itemDef
		{
			name goldline
			style WINDOW_STYLE_SHADER
			rect -10 34 380 24
			background "popmenu_goldline"
			visible 1
			decoration
		}

		itemDef
		{
			name title
			text "CO-OP"
			style 0
			textscale .5
			textstyle ITEM_TEXTSTYLE_SHADOWED
			rect 180 34 110 20
			textalign 1
			textalignx -7
			textaligny 5
			decoration
			forecolor POPMENU_HEADER_COLOR
			visible 1
		}

		itemDef
		{
			name hint1
			text "@COOP_HINT1"
			style 0
			textscale .3
			textstyle ITEM_TEXTSTYLE_SHADOWED
			rect 20 62 320 16
			textalign 0
			textaligny 12
			decoration
			forecolor .9 .9 .9 1
			visible 1
		}
		itemDef
		{
			name hint2
			text "@COOP_HINT2"
			style 0
			textscale .3
			textstyle ITEM_TEXTSTYLE_SHADOWED
			rect 20 78 320 16
			textalign 0
			textaligny 12
			decoration
			forecolor .9 .9 .9 1
			visible 1
		}

		itemDef
		{
			name ip
			type ITEM_TYPE_EDITFIELD
			text "@COOP_ADDR"
			dvar "coop_ip"
			style 1
			maxchars 15
			maxPaintChars 15
			rect 20 98 320 22
			border 1
			bordercolor .5 .5 .5 .5
			textalign ITEM_ALIGN_LEFT
			textaligny 16
			textalignx 8
			textscale .32
			outlinecolor 1 .5 .5 .5
			forecolor .9 .9 .9 1
			backcolor 0 0 0 .4
			visible 1
			mouseEnter { play "mouse_over"; }
			action { play "mouse_click"; }
		}

		itemDef
		{
			name modelabel
			text "@COOP_STATUS"
			style 0
			textscale .3
			textstyle ITEM_TEXTSTYLE_SHADOWED
			rect 20 126 90 14
			textalign 0
			textaligny 11
			decoration
			forecolor .8 .8 .8 1
			visible 1
		}
		itemDef
		{
			name modevalue
			type ITEM_TYPE_TEXT
			style 0
			dvar "coop_status"
			textscale .3
			textstyle ITEM_TEXTSTYLE_SHADOWED
			rect 80 126 270 14
			textalign 0
			textaligny 11
			decoration
			forecolor 1 .9 .3 1
			visible 1
		}

		itemDef
		{
			name host
			text "HOST"
			type ITEM_TYPE_BUTTON
			textscale .45
			style UI_BUTTON_STYLE
			textfont UI_FONT_NORMAL
			textstyle ITEM_TEXTSTYLE_SHADOWED
			rect 20 150 150 30
			textalign 1
			textalignx 75
			textaligny 21
			forecolor UI_BUTTON_TEXT_COLOR
			visible 1
			action
			{
				play "mouse_click";
				setdvar coop_cmd "host";
			}
			mouseEnter { play "mouse_over"; }
		}
