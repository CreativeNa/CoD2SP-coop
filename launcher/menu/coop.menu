			textaligny 14
			textalignx 8
			textscale .3
			outlinecolor 1 .5 .5 .5
			forecolor .9 .9 .9 1
			backcolor 0 0 0 .4
			visible 1
			mouseEnter { play "mouse_over"; }
			action { play "mouse_click"; }
		}

